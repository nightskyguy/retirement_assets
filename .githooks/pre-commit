#!/bin/sh
#
# pre-commit - run the five node test suites, check the counts they report against the places
#              that pin them, run the Optimizer page's own suite in a headless browser, and run
#              the markdown preview gate; block the commit on any failure.
#
# WHY THIS EXISTS. A breakage is caught at the moment it would enter history, not when someone
# next opens the page and reads its self-check badge. The node suites cover the engines. The page
# suite (optimizer_tests.js, run by .githooks/page-suite.js) is the only automated check of
# optimizer_ui.js and the Monte Carlo tab, which no node suite can load.
#
# INSTALL: sh .githooks/install
# This file is NOT the file git runs. `core.hooksPath` is pinned to an absolute path in this
# repo (and separately in every worktree's own config.worktree, which outranks the repo config),
# so the installer drops a one-line shim there that execs this file from whichever working tree
# is committing. See .githooks/README.md.
#
# ESCAPE HATCH: `git commit --no-verify` skips this deliberately. Use it for a commit you know
# does not touch code; do not use it to get past a red suite. SKIP_PAGE_SUITE=1 skips only the
# browser run, for a machine with no Chrome or Edge, and says so on every commit.

set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
	echo "pre-commit: not inside a work tree, skipping tests." >&2
	exit 0
}
cd "$root" || exit 1

if ! command -v node >/dev/null 2>&1; then
	echo "pre-commit: BLOCKED - node is not on PATH, so the test suites cannot be verified." >&2
	echo "            Install node, or commit with --no-verify if you accept the risk." >&2
	exit 1
fi

# Every suite here sets process.exitCode = 1 on failure, so exit status is the signal.
# Listed slowest first: a broken engine is the likeliest failure and should surface first.
suites="optimizer_core.tests.js taxengine.tests.js taxPaymentPlanner.tests.js doclinks.tests.js feedback.tests.js"

# Completeness. The missing-suite check further down catches a LISTED suite that vanished; this
# catches the opposite and likelier case - a NEW suite committed to the repo and never added to the
# line above, which would simply never run while everything looked green.
#
# THE GLOB IS `*.tests.js` AND MUST NEVER BE WIDENED TO `*test*`. optimizer_tests.js is the
# browser-only release gate: it declares runTests() and never calls it, so `node optimizer_tests.js`
# exits 0 having run nothing - and this hook reports success for anything that exits 0. Sweeping it
# in here would print a permanent, cheerful green for zero tests actually run, on the one file
# publishing is checked against. `_tests.js` does not match `*.tests.js`, which is what keeps the
# browser gate and the node suites disjoint. That is the whole reason the suffix was chosen.
ondisk=$(for f in *.tests.js; do [ -f "$f" ] && echo "$f"; done | sort | tr '\n' ' ')
listed=$(printf '%s\n' $suites | sort | tr '\n' ' ')
if [ "$ondisk" != "$listed" ]; then
	echo "pre-commit: BLOCKED - the suites list in .githooks/pre-commit is out of date." >&2
	echo "            on disk: $ondisk" >&2
	echo "            listed:  $listed" >&2
	echo "            Add the new suite to suites= (or drop the stale entry) in this same commit." >&2
	exit 1
fi

failed=""
missing=""
counts=""
started=$(date +%s)

for suite in $suites; do
	if [ ! -f "$suite" ]; then
		missing="$missing $suite"
		continue
	fi
	printf 'pre-commit: %-28s ' "$suite"
	# Tested as the `if` condition rather than via $? so the status cannot be clobbered.
	if output=$(node "$suite" 2>&1); then
		# Suites print "Results: N passed, M failed" as their last summary line. N is the suite's
		# test count when it passes, which check-pins.js compares with the pinned counts.
		result=$(echo "$output" | grep -m1 '^Results:')
		echo "${result:-ok}"
		n=$(echo "$result" | sed -n 's/^Results: \([0-9][0-9]*\) passed.*/\1/p')
		counts="$counts ${suite%.tests.js}=${n:-0}"
	else
		echo "FAILED"
		failed="$failed $suite"
		echo "$output" | tail -25
	fi
done

elapsed=$(( $(date +%s) - started ))

# A suite that has been renamed or deleted must not pass silently - that is the exact failure
# mode P39 exists to remove, and it would look identical to a green run.
#
# Now a BACKSTOP, not the primary path: the completeness check above catches a deleted or renamed
# *.tests.js first, and says the same thing in more detail. This still fires for the one case that
# check cannot see - a suite listed in suites= whose name does not end in .tests.js. Kept because
# the cost is three lines and the failure it guards is silent.
if [ -n "$missing" ]; then
	echo "pre-commit: BLOCKED - expected suite(s) not found:$missing" >&2
	echo "            If a suite was renamed or removed on purpose, update .githooks/pre-commit" >&2
	echo "            in the same commit." >&2
	exit 1
fi

if [ -n "$failed" ]; then
	echo "pre-commit: BLOCKED after ${elapsed}s - failing suite(s):$failed" >&2
	echo "            Re-run one directly for the full output, e.g. node$failed" >&2
	exit 1
fi

echo "pre-commit: all five node suites passed in ${elapsed}s."

# The counts just reported, against TestTiers.EXPECTED (the page badge turns red on a difference)
# and the suite table in .githooks/README.md.
if ! node .githooks/check-pins.js $counts; then
	exit 1
fi

# The page's own suite in a headless Chrome or Edge, including its state-writing tests. See the
# header of .githooks/page-suite.js for what it serves and what it refuses.
if [ "${SKIP_PAGE_SUITE:-}" = "1" ]; then
	echo "pre-commit: page suite SKIPPED (SKIP_PAGE_SUITE=1) - optimizer_ui.js and the Monte Carlo tab were not checked." >&2
elif ! node .githooks/page-suite.js; then
	echo "            Re-run it directly for the same output: node .githooks/page-suite.js" >&2
	exit 1
fi

# A staged script or stylesheet whose ?v= token did not move. The page would then be served new
# against a cached old file, which is not a failure - it is a silently wrong answer on one reader's
# machine. Header of .githooks/check-asset-tokens.js for the rule and for why this is a per-asset
# check rather than one ASSET_VERSION.
if ! node .githooks/check-asset-tokens.js; then
	echo "            Run it directly for the list: node .githooks/check-asset-tokens.js" >&2
	exit 1
fi

# Markdown that silently hides the rest of itself. A bare <select> in task_plan.md cost 4,430
# lines of VS Code preview on 2026-08-28, and a bare <details> cost progress.md ~1,944.
# GitHub sanitizes the tag away so the files review perfectly; only an unsanitized preview
# reproduces it, and it looks like file corruption rather than a typo. Scans every tracked .md,
# not just the staged ones - the check is milliseconds and the failure is silent by nature.
# Rationale, the denylist and why a blanket no-raw-HTML rule was rejected: the header comment
# of .githooks/md-html-scan.js.
if ! node .githooks/md-html-scan.js; then
	echo "            Run it directly for the list: node .githooks/md-html-scan.js" >&2
	exit 1
fi

exit 0
